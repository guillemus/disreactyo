{
  "name": "disreactyo",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i frontend/src/styles.css -o public/static/app.css --minify",
    "build:js": "node build.mjs",
    "build": "pnpm build:css && pnpm build:js",
    "dev": "pnpm build && concurrently -k -n css,js,worker \"tailwindcss -i frontend/src/styles.css -o public/static/app.css --watch\" \"node build.mjs --watch\" \"wrangler dev\"",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "dependencies": {
    "@starfederation/datastar-sdk": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
